# Copy thành .env rồi điền key của MỘT dịch vụ. File .env không được commit.
# Chọn dịch vụ: fpt | azure | google | gemini
TTS_PROVIDER=fpt
# Tốc độ đọc: -2 (chậm) … 2 (nhanh)
TTS_SPEED=0

# FPT.AI: https://console.fpt.ai → Text to Speech → API key
# Giọng nam: leminh, giahuy, minhquang · nữ: banmai, thuminh, myan, lannhi, linhsan
FPT_API_KEY=
FPT_VOICE=leminh

# Azure Speech: portal.azure.com → tạo Speech service (Azure for Students không cần thẻ)
# Giọng nam: vi-VN-NamMinhNeural · nữ: vi-VN-HoaiMyNeural
AZURE_SPEECH_KEY=
AZURE_REGION=southeastasia
AZURE_VOICE=vi-VN-NamMinhNeural

# Google Cloud Text-to-Speech: console.cloud.google.com → bật API → tạo API key
# Giọng nam: vi-VN-Neural2-D · nữ: vi-VN-Neural2-A
GOOGLE_API_KEY=
GOOGLE_VOICE=vi-VN-Neural2-D

# Gemini TTS: https://aistudio.google.com → Get API key (miễn phí, không cần thẻ)
# Giọng nam: Charon, Orus, Puck · nữ: Kore, Aoede, Leda
GEMINI_API_KEY=
GEMINI_VOICE=Charon
# Cách đọc (tiếng Anh cho ổn định), ví dụ: energetic and friendly
GEMINI_STYLE=clear, confident university seminar presenter, warm and natural, moderate pace
